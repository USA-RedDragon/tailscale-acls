// This tailnet's ACLs are maintained in https://github.com/USA-RedDragon/tailscale-acls
{
	"tagOwners": {
		"tag:open": ["autogroup:admin"],
		"tag:katelyn-comma": ["autogroup:admin"],
		"tag:jacob-comma": ["autogroup:admin"],
		"tag:dns": ["autogroup:admin","tag:k8s-operator"],
		"tag:ntp": ["autogroup:admin","tag:k8s-operator"],
		"tag:mqtt": ["autogroup:admin","tag:k8s-operator"],
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s": ["tag:k8s-operator"],
		"tag:golink": ["autogroup:admin"],
		"tag:vacuum": ["autogroup:admin","tag:k8s-operator"],
		"tag:observatory": ["autogroup:admin"],
		"tag:ereader": ["autogroup:admin"],
		"tag:untrusted": ["autogroup:admin"]
	},

	"acls": [
		// Admins can access admin tag
		{"action": "accept", "src": ["autogroup:admin"], "dst": ["*:*"]},
		// tag:open is open for observatory
		{"action": "accept", "src": ["tag:observatory","tag:katelyn-comma","tag:jacob-comma"], "dst": ["tag:open:*"]},
		// allow k8s to touch observatory
		{"action": "accept", "src": ["tag:k8s"], "dst": ["tag:observatory:*"]},
                // observatory can mqtt and power switch
		{"action": "accept", "src": ["tag:observatory"], "dst": ["100.73.149.46:1883","100.84.20.102:*","tag:mqtt:*"]},
		// ereader can reach calibre
		{"action": "accept", "src": ["tag:ereader"], "dst": ["100.104.18.64:9090"]},
		// Can always own comma
		{"action": "accept", "src": ["katelyn.c.maes@gmail.com"], "dst": ["tag:katelyn-comma:*"]},
		{"action": "accept", "src": ["autogroup:member"], "dst": ["autogroup:self:*"]},
		// TCP: Can always access internet, self, tagged open, dns over tcp, funnels/serve
		{"action": "accept", "src": ["katelyn.c.maes@gmail.com"], "proto": "tcp", "dst": ["autogroup:internet:*","tag:open:*","tag:dns:53","autogroup:member:443","tag:golink:80","tag:golink:443","tag:mqtt:*","tag:vacuum:443","tag:vacuum:80"]},
		{"action": "accept", "src": ["jacob@mcswain.dev"], "proto": "tcp", "dst": ["autogroup:internet:*","tag:open:*","tag:dns:53","autogroup:member:443","tag:golink:80","tag:golink:443","tag:mqtt:*","tag:vacuum:443","tag:vacuum:80"]},
		// UDP: Can always access internet, self, tagged open, ntp, dns, quic
		{"action": "accept", "src": ["katelyn.c.maes@gmail.com"], "proto": "udp", "dst": ["autogroup:internet:*","tag:open:*","tag:ntp:123","tag:dns:53","autogroup:member:443","tag:vacuum:443","tag:vacuum:80","tag:golink:80","tag:golink:443"]},
		{"action": "accept", "src": ["jacob@mcswain.dev"], "proto": "udp", "dst": ["autogroup:internet:*","tag:open:*","tag:ntp:123","tag:dns:53","autogroup:member:443","tag:vacuum:443","tag:vacuum:80","tag:golink:80","tag:golink:443"]},
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
		{
			"action": "check",
			"src":    ["katelyn.c.maes@gmail.com"],
			"dst":    ["tag:katelyn-comma"],
			"users":  ["autogroup:nonroot"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["autogroup:self","tag:katelyn-comma","tag:jacob-comma","tag:observatory"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	"tests": [
	 	{
	 		"src": "jacob@mcswain.dev",
	 		"proto": "tcp",
			"accept": ["100.126.56.39:80","100.64.23.110:80","tag:jacob-comma:126","tag:katelyn-comma:126","tag:vacuum:443","tag:vacuum:80"],
	 	},
		{
	 		"src": "torvalds@github",
	 		"accept": [],
	 		"proto": "tcp",
	 		"deny": ["tag:open:80"],
	 	},
		{
	 		"src": "tag:observatory",
	 		"accept": ["tag:open:80"],
	 		"proto": "tcp",
	 		"deny": ["100.126.56.39:80","tag:dns:5353","tag:ntp:123","tag:jacob-comma:126","tag:vacuum:1111"],
	 	},
		{
	 		"src": "katelyn.c.maes@gmail.com",
	 		"proto": "tcp",
			// accept phone, open, dns over tcp, member 443, and self comma
	 		"accept": ["100.64.23.110:80","tag:open:80","tag:dns:53","100.126.56.39:443","tag:katelyn-comma:126","tag:golink:443","tag:golink:80","tag:vacuum:443","tag:vacuum:80"],
			// deny framework 13, dns on wrong port and proto, ntp wrong proto, jacob comma
	 		"deny": ["100.126.56.39:80","tag:dns:5353","tag:ntp:123","tag:jacob-comma:126","tag:vacuum:1111"],
	 	},
		{
	 		"src": "katelyn.c.maes@gmail.com",
	 		"proto": "udp",
			// accept phone, open, dns, quic, ntp, and self comma
	 		"accept": ["100.64.23.110:80","tag:open:80","tag:dns:53","100.126.56.39:443","tag:ntp:123","tag:katelyn-comma:126","tag:vacuum:443","tag:vacuum:80"],
			// deny framework 13, dns on wrong port, ntp on wrong port, jacob comma
	 		"deny": ["100.126.56.39:80","tag:dns:5353","tag:ntp:1234","tag:jacob-comma:126","tag:vacuum:1111"],
	 	},
	],

	"sshTests": [
		{
			"src": "jacob@mcswain.dev",
			"dst": ["100.126.56.39"],
			"accept": ["admin", "reddragon"],
		},
		{
			"src": "katelyn.c.maes@gmail.com",
			"dst": ["100.114.185.46"],
			"check": ["admin", "reddragon"],
			"deny": ["root"],
		},
		{
			"src": "katelyn.c.maes@gmail.com",
			"dst": ["tag:katelyn-comma"],
			"check": ["comma", "reddragon"],
			"deny": ["root"],
		},
		{
			"src": "jacob@mcswain.dev",
			"dst": ["tag:katelyn-comma"],
			"accept": ["comma", "reddragon", "root"],
		},
		{
			"src": "jacob@mcswain.dev",
			"dst": ["tag:jacob-comma"],
			"accept": ["comma", "reddragon", "root"],
		},
		{
			"src": "100.64.23.110",
			"dst": ["100.114.185.46"],
			"check": ["admin", "reddragon"],
			"deny": ["root"],
		},
		{
			"src": "100.64.23.110",
			"dst": ["100.126.56.39"],
			"deny": ["admin", "reddragon", "root"],
		},
		{
			"src": "100.106.64.82",
			"dst": ["100.126.56.39"],
			"accept": ["admin", "reddragon", "root"],
		},
	],
	"nodeAttrs": [
		{
			"target": ["autogroup:member","tag:k8s"],
			"attr":   ["funnel"],
		},
	],
	"grants": [{
      "src": ["autogroup:admin"],
      "dst": ["tag:golink"],
      "app": {
        "tailscale.com/cap/golink": [{
            "admin": true
        }]
      }
  }]
}
